<%- include("partials/header") %>

<%- include("partials/navbar") %>


<!-- =====================================================
     SERVICES PAGE
===================================================== -->

<section class="container py-5">


    <!-- =================================================
         PAGE HEADING
    ================================================== -->

    <div class="text-center mb-5">

        <h1 class="display-4 fw-bold">
            Our Services
        </h1>

        <p class="lead">
            Professional fire weed abatement, disking,
            vegetation management, mulching, brush clearing,
            and property cleanup services.
        </p>

    </div>



    <!-- =================================================
         SERVICE CARDS
    ================================================== -->

    <div class="row g-4">


        <!-- =================================================
             FIRE WEED ABATEMENT
        ================================================== -->

        <div class="col-md-6">

            <div class="card h-100 shadow">

                <img
                    src="/images/image_1.jpg"
                    class="card-img-top"
                    alt="Fire weed abatement services"
                    style="height: 300px; object-fit: cover;">

                <div class="card-body p-4">

                    <h2 class="card-title">
                        Fire Weed Abatement
                    </h2>

                    <p class="card-text">
                        Bower Company provides professional fire weed
                        abatement services designed to reduce heavy
                        vegetation, dry weeds, brush, and other combustible
                        growth around residential, commercial, agricultural,
                        and undeveloped properties.
                    </p>

                    <p class="card-text">
                        Our equipment allows us to efficiently clear large
                        areas of unwanted vegetation while helping property
                        owners maintain cleaner and more manageable land.
                    </p>

                </div>

            </div>

        </div>



        <!-- =================================================
             DISKING
        ================================================== -->

        <div class="col-md-6">

            <div class="card h-100 shadow">

                <img
                    src="/images/image_3.png"
                    class="card-img-top"
                    alt="Disking and vegetation control"
                    style="height: 300px; object-fit: cover;">

                <div class="card-body p-4">

                    <h2 class="card-title">
                        Disking & Vegetation Control
                    </h2>

                    <p class="card-text">
                        Disking provides an effective method for controlling
                        weeds and unwanted vegetation across open fields,
                        vacant lots, agricultural land, and larger properties.
                    </p>

                    <p class="card-text">
                        Heavy equipment pulls specialized disks through the
                        soil, cutting vegetation and working plant material
                        into the ground. This helps eliminate standing weeds
                        while leaving the property cleaner and easier to
                        maintain.
                    </p>

                </div>

            </div>

        </div>



        <!-- =================================================
             MULCHING & BRUSH CLEARING
        ================================================== -->

        <div class="col-md-6">

            <div class="card h-100 shadow">

                <img
                    src="/images/image_2.png"
                    class="card-img-top"
                    alt="Mulching and brush clearing"
                    style="height: 300px; object-fit: cover;">

                <div class="card-body p-4">

                    <h2 class="card-title">
                        Mulching & Brush Clearing
                    </h2>

                    <p class="card-text">
                        Our mulching and brush clearing services help remove
                        thick weeds, brush, tall grass, and overgrown
                        vegetation from properties that have become difficult
                        to maintain.
                    </p>

                    <p class="card-text">
                        Specialized equipment cuts and processes vegetation
                        efficiently, helping open up overgrown areas and
                        improve property accessibility while reducing
                        accumulated vegetation and potential fire fuel.
                    </p>

                </div>

            </div>

        </div>



        <!-- =================================================
             STUMP & VEGETATION REMOVAL
        ================================================== -->

        <div class="col-md-6">

            <div class="card h-100 shadow">

                <img
                    src="/images/image_4.png"
                    class="card-img-top"
                    alt="Stump and vegetation removal"
                    style="height: 300px; object-fit: cover;">

                <div class="card-body p-4">

                    <h2 class="card-title">
                        Stump & Vegetation Removal
                    </h2>

                    <p class="card-text">
                        We provide property clearing services for unwanted
                        vegetation, brush, small trees, roots, stumps, and
                        other growth that can interfere with property use
                        and maintenance.
                    </p>

                    <p class="card-text">
                        Whether preparing an area for future use or simply
                        reclaiming an overgrown property, our equipment
                        provides an efficient way to clear difficult
                        vegetation and improve the condition of the land.
                    </p>

                </div>

            </div>

        </div>


    </div>

</section>



<!-- =====================================================
     CALL TO ACTION
===================================================== -->

<section class="bg-dark text-white py-5">

    <div class="container text-center">

        <h2 class="fw-bold">
            Need Your Property Cleared?
        </h2>

        <p class="lead mb-4">
            Contact Bower Company today for fire weed abatement,
            disking, mulching, brush clearing, and vegetation
            management services.
        </p>

        <a
            href="/contact"
            class="btn btn-warning btn-lg">

            Request A Quote

        </a>

    </div>

</section>



